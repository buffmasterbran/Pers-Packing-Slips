## Database (Coolify Postgres service)
# Prefer DATABASE_URL. If omitted, app can build one from POSTGRES_* vars.
DATABASE_URL=postgresql://postgres:change_me@postgres:5432/pers_packing_slips

# Optional explicit DB parts (used if DATABASE_URL is not provided)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
POSTGRES_DB=pers_packing_slips

# Optional SSL mode: disable | require | no-verify
# For internal Coolify Postgres, disable is usually correct.
DB_SSL_MODE=disable

## NetSuite API
NETSUITE_RESTLET_URL=https://7913744.restlets.api.netsuite.com/app/site/hosting/restlet.nl?script=2796&deploy=1
NETSUITE_REALM=7913744
NETSUITE_OAUTH_CONSUMER_KEY=your_consumer_key_here
NETSUITE_OAUTH_CONSUMER_SECRET=your_consumer_secret_here
NETSUITE_OAUTH_TOKEN=your_token_here
NETSUITE_OAUTH_TOKEN_SECRET=your_token_secret_here
